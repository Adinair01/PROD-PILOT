# Base URL of the PROD PILOT backend API.
#
# LEAVE THIS UNSET in normal local and deployed use. The app calls a same-origin
# `/v1`, which the Vite dev server (vite.config.js) and the hosting rewrites
# (frontend/vercel.json, netlify.toml) forward to the backend. That is what keeps
# the auth cookies first-party — pointing this at the backend's own domain makes
# them third-party cookies, which Safari blocks and Chrome is phasing out, and
# users get signed out mid-session as a result.
#
# Only set it (including the /v1 prefix) to aim a build at a different backend:
# VITE_API_URL=https://some-other-backend.example.com/v1

# Google Sign-In — optional, the button just doesn't render if unset.
VITE_GOOGLE_CLIENT_ID=934644728001-5bof9mf0k8jcu4a8391ms139lktkr08g.apps.googleusercontent.com
